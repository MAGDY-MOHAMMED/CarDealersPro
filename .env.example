# Database Settings
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=CarDealersPro
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# JWT Settings
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RSA Keys (base64 encoded for cloud deployment)
# For local development, use private.pem and public.pem files instead
# To convert keys to base64: base64 -w 0 private.pem
PRIVATE_KEY_BASE64=
PUBLIC_KEY_BASE64=
