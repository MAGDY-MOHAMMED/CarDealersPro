# Database Settings
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=CarDealersPro

# 3-Tier Database User Configuration (for database access control)
# Primary user: Used for general operations (default engine)
DATABASE_PRIMARY_USER=postgres
DATABASE_PRIMARY_PASSWORD=your_password_here

# Write user: Used for API POST, PUT, DELETE operations
DATABASE_WRITE_USER=postgres
DATABASE_WRITE_PASSWORD=your_password_here

# Read user: Used for GET operations and reports (read-only)
DATABASE_READ_USER=postgres
DATABASE_READ_PASSWORD=your_password_here

# Legacy single user configuration (for backward compatibility)
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# JWT Settings
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RSA Keys (base64 encoded for cloud deployment)
# For local development, use private.pem and public.pem files instead
# To convert keys to base64: base64 -w 0 private.pem
PRIVATE_KEY_BASE64=
PUBLIC_KEY_BASE64=
