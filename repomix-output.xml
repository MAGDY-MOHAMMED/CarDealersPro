services:
  # ============================================================
  # FastAPI: الـ API
  # ============================================================
  api:
    build: 
      context: .
      dockerfile: Dockerfile
    container_name: cardealers-api
    ports:
      - "${API_PORT:-8000}:8000"
    env_file:
      - .env
    environment:
      - WEB_CONCURRENCY=${WEB_CONCURRENCY:-4}
      - LOG_LEVEL=${LOG_LEVEL:-info}
    restart: always
    networks:
      - main-net
    volumes:
      - storage-uploads:/app/storage/uploads
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  main-net:
    driver: bridge

volumes:
  storage-uploads: # storage-uploads is a volume that will be used to store uploaded files
