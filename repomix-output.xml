  - add_docker_metadata: ~
  - script:
      lang: javascript
      source: >
        function process(event) {
          // Extract request_id from log message if present
          var message = event.Get("message");
          if (message && typeof message === 'string') {
            var requestIdMatch = message.match(/\[request_id:\s*([^\]]+)\]/);
            if (requestIdMatch) {
              event.Put("request_id", requestIdMatch[1]);
